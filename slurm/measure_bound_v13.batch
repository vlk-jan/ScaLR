#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --time=3:00:00
#SBATCH --error=slurm/out/measure_bound_v13_%j.err
#SBATCH --output=slurm/out/measure_bound_v13_%j.out
#SBATCH --partition=cpu
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
source .h200_env
cd "$SLURM_SUBMIT_DIR" || exit 1
# Best-constant bound for the labels a run on the single root actually reads:
# setprop/HELHEST -> HELHEST_v1_3, whose proprio_labels were generated on v1.3
# odometry + clip-1.0 height maps (DRIFT job 11483468). The alt arm reads the
# 2026-08-28 framefix set on the SAME v1_3 clouds, for a paired comparison.
# Any config reading these labels must carry the v1_3 bound as constant_bound.
n=$(find /mnt/personal/vlkjan6/HELHEST_v1_3 -maxdepth 3 -path '*/proprio_labels/*.npz' | wc -l)
echo "v1_3 label files: $n"; [ "$n" -gt 100000 ] || { echo "FATAL: labels incomplete"; exit 1; }
python3 -u scripts/measure_proprio_bound.py --frames 2500 \
  --path_dataset /mnt/personal/vlkjan6/setprop --shipped_tag /setprop --alt_tag /setprop_framefix \
  --shipped_name "V1_3 LABELS (base_link odometry, clip 1.0)" --alt_name "FRAMEFIX 2026-08-28 (same clouds)"
